# ==============================================================================
# Aura Weather Application — Environment Configuration Template
# ==============================================================================
# Instructions: Copy this file to '.env' and insert your OpenWeatherMap API key.

# OpenWeatherMap API Key (Free key from: https://home.openweathermap.org/api_keys)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
VITE_OPENWEATHER_API_KEY=your_openweathermap_api_key_here
API_KEY=your_openweathermap_api_key_here

# Weather API Base URL (OpenWeatherMap 2.5 Standard)
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Default Location: "current" (auto-detects GPS & IP) or specify fallback city (e.g. "London")
DEFAULT_LOCATION=current

# Default Temperature Unit: "metric" (°C, km/h) or "imperial" (°F, mph)
DEFAULT_UNIT=metric

# IP Geolocation Endpoints for automatic fallback location detection
IP_GEO_URL=https://ipapi.co/json/
IP_GEO_FALLBACK_URL=https://ipwho.is/
